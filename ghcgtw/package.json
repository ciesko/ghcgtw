{
  "name": "github-copilot-gateway",
  "displayName": "GitHub Copilot AI Gateway",
  "description": "Expose GitHub Copilot's AI API as a local HTTP server",
  "version": "0.1.0",
  "publisher": "ciesko",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ciesko/ghcgtw.git"
  },
  "keywords": [
    "github-copilot",
    "ai",
    "llm",
    "openai",
    "api-gateway",
    "proxy"
  ],
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "github-copilot-gateway.start",
        "title": "Start AI Gateway Server",
        "category": "AI Gateway"
      },
      {
        "command": "github-copilot-gateway.stop",
        "title": "Stop AI Gateway Server",
        "category": "AI Gateway"
      },
      {
        "command": "github-copilot-gateway.selectModel",
        "title": "Select AI Model",
        "category": "AI Gateway",
        "icon": "$(hubot)"
      },
      {
        "command": "github-copilot-gateway.openDashboard",
        "title": "Open Dashboard",
        "category": "AI Gateway",
        "icon": "$(dashboard)"
      }
    ],
    "configuration": {
      "title": "GitHub Copilot AI Gateway",
      "properties": {
        "github-copilot-gateway.port": {
          "type": "number",
          "default": 3000,
          "description": "Port number for the AI Gateway server",
          "minimum": 1024,
          "maximum": 65535
        },
        "github-copilot-gateway.defaultModel": {
          "type": "string",
          "default": "gpt-5-mini",
          "description": "Default model family to use when no model is specified (e.g., gpt-5-mini, gpt-4o, claude-sonnet)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
